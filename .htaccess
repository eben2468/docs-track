# Local Apache (XAMPP) safety net: this project lives inside htdocs, so without
# this file .env, storage/ and vendor/ would be web-accessible. Everything is
# routed into public/, which is the only intended web root. Production (Nginx)
# points the document root directly at public/ and ignores this file.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public/)(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
