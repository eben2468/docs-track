APP_NAME="VVU Document Tracking System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra
# Encrypts secrets stored in the database (e.g. the SMTP password set in Admin > Settings). Generate with:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)), PHP_EOL;"
# Changing it later means re-entering the SMTP password in Settings.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vvu_dts
DB_USERNAME=root
DB_PASSWORD=

# MAIL_TRANSPORT: smtp (send via MAIL_HOST) or log (write to storage/logs/mail.log, for local testing)
# Sign-in codes are emailed, so nobody can sign in unless email works.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls, MAIL_USERNAME and
# MAIL_FROM_ADDRESS = the Gmail address, MAIL_PASSWORD = a 16-character App Password.
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dts@vvu.edu.gh
MAIL_FROM_NAME="VVU DTS"

SESSION_LIFETIME_MINUTES=30
