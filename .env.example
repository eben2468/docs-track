APP_NAME="VVU Document Tracking System"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Accra

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vvu_dts
DB_USERNAME=root
DB_PASSWORD=

# MAIL_TRANSPORT: smtp (send via MAIL_HOST) or log (write to storage/logs/mail.log, for local testing)
MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dts@vvu.edu.gh
MAIL_FROM_NAME="VVU DTS"

SESSION_LIFETIME_MINUTES=30
