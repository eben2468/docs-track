# Production .env for the VVU DTS server. Copy to <project>/.env, fill in the secrets,
# then `chmod 640 .env`. Never commit the real file.

APP_NAME="VVU Document Tracking System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://dts.vvu.edu.gh
APP_TIMEZONE=Africa/Accra

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=vvu_dts
DB_USERNAME=vvu_dts
DB_PASSWORD=change-me-to-a-long-random-password

MAIL_TRANSPORT=smtp
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=dts@vvu.edu.gh
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=dts@vvu.edu.gh
MAIL_FROM_NAME="VVU DTS"

SESSION_LIFETIME_MINUTES=30
